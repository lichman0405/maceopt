# MACEOPT Configuration Example
# Copy this file to .env and modify as needed

# Model Configuration
MACE_MODEL_PATH=models/mace_agnesi_medium.model

# Output Directory
OUTPUT_DIR=output

# Server Configuration
UVICORN_HOST=0.0.0.0
UVICORN_PORT=4748
WORKERS=4

# File Upload Limits (in MB)
MAX_UPLOAD_SIZE_MB=50

# Device Configuration (auto/cpu/cuda/mps)
# auto = automatic detection, cpu = force CPU, cuda = force CUDA, mps = force Metal Performance Shaders (Mac)
DEVICE=auto

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Structure Validation
MAX_ATOMS_WARNING=1000    # Warn for structures larger than this
MAX_ATOMS_LIMIT=10000     # Reject structures larger than this

# Supported File Formats (comma-separated)
SUPPORTED_FORMATS=.xyz,.cif,.vasp,.poscar,.contcar
